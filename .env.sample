# Site — MUST use www for Moolre callbacks (apex redirects POST and drops the body)
NEXT_PUBLIC_APP_URL=https://www.fastdataservices.store

# Optional: protect /api/cron/reconcile-payments (Vercel sends Authorization: Bearer <secret>)
CRON_SECRET=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Moolre Mobile Money
MOOLRE_API_USER=
# Public key — used for both payment initiation (USSD prompt) and status checks
MOOLRE_API_PUBKEY=
# Private API key — optional; not currently required for the payment flow
MOOLRE_API_KEY=
MOOLRE_ACCOUNT_NUMBER=
MOOLRE_MERCHANT_EMAIL=
MOOLRE_CALLBACK_SECRET=
MOOLRE_SMS_API_KEY=
MOOLRE_MOOLRE_SMS_SENDER_ID=FASTDATA

# Email (Resend) — order receipts to customers + new-order alerts to admin
RESEND_API_KEY=
ADMIN_EMAIL=
# Verified sender, e.g. "Fast Data Services <orders@fastdataservices.store>"
EMAIL_FROM=

# Phone that receives admin SMS alerts (new orders, wallet top-ups).
# Falls back to platform config support WhatsApp number if unset.
ADMIN_NOTIFY_PHONE=

# Groq AI chat (orders + customer service)
GROQ_API_KEY=
CHAT_GUEST_USER_ID=

# Skanka5 supplier
# Skanka5 supplier (optional backup)
SKANKA5_API_KEY=
SKANKA5_WEBHOOK_SECRET=
SKANKA5_NETWORK_ID_MTN=3

# SuccessBiz / DataCoreGH supplier
SUCCESSBIZHUB_API_KEY=
# Webhook secret from the supplier's Webhook Settings.
# If you enable "HMAC webhook signatures" there, we verify X-Webhook-Signature (sha256).
# If HMAC is off, the same value is accepted as a plain x-webhook-secret / x-api-key header.
SUCCESSBIZHUB_WEBHOOK_SECRET=
SUCCESSBIZHUB_OFFER_SLUG_MTN=mtn
SUCCESSBIZHUB_OFFER_SLUG_TELECEL=telecel
SUCCESSBIZHUB_OFFER_SLUG_AT=ishare
SUPPLIER_FOR_MTN=successbizhub
SUPPLIER_FOR_TELECEL=successbizhub
SUPPLIER_FOR_AT=successbizhub
